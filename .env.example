# CampusGuard AI Environment Configuration Example
# Copy this file to .env and configure values:
# Windows (PowerShell): Copy-Item .env.example .env

# Secret key used for signing JWT access tokens (REQUIRED).
# The backend will not start if this is left empty or as the default placeholder.
# Generate a secure random 64-character hex key by running:
# python -c "import secrets; print(secrets.token_hex(32))"
CAMPUSGUARD_SECRET_KEY=your_generated_secret_key_here

# Google Gemini API key for AI assistant LLM answers (OPTIONAL).
# If omitted or left empty, the assistant safely falls back to local hybrid RAG retrieval from campus documents.
GEMINI_API_KEY=your_gemini_api_key_here
